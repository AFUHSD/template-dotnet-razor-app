root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning

# Test names are sentences (Every_page_with_a_code_behind_declares_its_model): underscores are the point.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
# xunit has no synchronization context; ConfigureAwait noise adds nothing in tests.
dotnet_diagnostic.CA2007.severity = none
